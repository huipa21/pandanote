{
  "name": "pandanote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.tests.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "auth:setup-token": "node --env-file-if-exists=.env scripts/setup-token.ts",
    "auth:benchmark": "node scripts/auth-benchmark.ts",
    "images:benchmark": "node scripts/images-benchmark.ts",
    "auth:recover": "node --env-file-if-exists=.env scripts/auth-recover.ts",
    "spike:browser": "vite --config tests/browser/vite.config.ts --host 127.0.0.1 --port 4174 --strictPort"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.0",
    "argon2": "0.45.1",
    "better-sqlite3": "12.11.1",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.3",
    "mermaid": "12.1.0",
    "otplib": "13.5.0",
    "qrcode": "1.5.4",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "svelte": "5.57.1",
    "tar-stream": "3.2.2",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
