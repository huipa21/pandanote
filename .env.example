# Local development only. Production requires an HTTPS origin.
ORIGIN=http://localhost:5173
# Private persistent storage. Run npm run db:migrate before domain services start.
# Production must set an absolute path outside source/build/static on local persistent disk.
# Linux: owner-only permissions enforced. Windows: configure a private NTFS ACL.
DATA_DIR=./data
# Optional comma-separated exact peer IPs for your private reverse proxy (max 16).
# The proxy MUST overwrite X-Forwarded-For with one client IP, not append a chain.
# Leave adapter ADDRESS_HEADER/HOST_HEADER/PROTOCOL_HEADER/PORT_HEADER unset.
TRUSTED_PROXY_IPS=
# Adapter transport ceiling; domain handlers still enforce actual streamed-byte limits.
# Raise this alongside configurable per-file limits (maximum currently 500 MB).
# Streaming transport ceiling for full .pnb restore uploads; domain limits and
# private disk reservations remain authoritative. Match the reverse-proxy limit.
BODY_SIZE_LIMIT=64G
# Default disk reserve is max(5 GiB, 10% filesystem capacity). Optional operator override:
# DISK_RESERVE_BYTES=5368709120
