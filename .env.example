# The web address of your notes site: https, no trailing slash.
ORIGIN=https://notes.example.com

# Optional
# DATA_PATH=./data   # folder on this server that holds all notes and files
# PUID=1000          # user and group that own the data folder
# PGID=1000
# TRUSTED_PROXIES=172.18.0.2  # optional: your fixed Caddy peer IP; see ops/DEPLOYMENT.md
# Use none to ignore X-Forwarded-For. Unset/blank retains private-network peer trust.
