# Full common/native/Git/PTY regression, not production and not a browser driver.
FROM docker.io/library/node:24.21.0-alpine3.23@sha256:9ec4a2e289874ed0d722e1772ec2de45d2801541db8612f3638b26f128c69ac2
WORKDIR /app
COPY . .
# Test-only Git, util-linux script, OpenSSL and GNU coreutils/find semantics.
RUN apk add --no-cache ca-certificates python3 make g++ git bash util-linux openssl coreutils findutils \
    && npm ci
CMD ["sh", "-c", "node --version && npm --version && npm run check && npm run lint && npm run test:unit && npm run test:integration && npm run build"]
