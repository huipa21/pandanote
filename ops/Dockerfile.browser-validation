# Full nonvisual Linux/Chromium regression; Windows shell snapshots remain a separate audit.
FROM docker.io/library/node:24.21.0-bookworm-slim@sha256:5cbc7caba8c2c0f0bca675d1b61b9f2857e1cf1853c6164ee9dd409501a936e7
WORKDIR /app
# Chromium needs a UTF-8 filesystem locale to preserve Unicode download names.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
COPY . .
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl git python3 make g++ util-linux \
    && npm ci \
    && npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
CMD ["sh", "-c", "npm run test:e2e -- $(find tests/e2e -name '*.test.ts' ! -name 'shell.test.ts' | sort)"]
