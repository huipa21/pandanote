# Copy to .env alongside docker-compose.yml; chmod 600 .env. Never commit it.
PANDANOTE_IMAGE=localhost/pandanote:latest
ORIGIN=https://notes.example.com
# Caddy's STATIC IP on the shared Docker network, not the VPS public IP.
TRUSTED_PROXY_IPS=172.20.0.2
PROXY_NETWORK=proxynet
DATA_PATH=./app-data
PUID=1000
PGID=1000
STOP_GRACE_PERIOD=60s
# First startup only: paste a cryptographically random 43-character base64url token.
# Generate on the build machine: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Enter this token at /setup within one hour. Remove it here after account creation
# and recreate the container to remove it from Docker's saved environment too.
# Restarts with the same token never extend expiry; rotate it if setup expired.
SETUP_TOKEN=
# Optional transport limit (domain-specific upload/restore limits still apply).
BODY_SIZE_LIMIT=64G
# DISK_RESERVE_BYTES=
