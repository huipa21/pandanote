# Copy to .env next to compose.yaml. Keep it private; it holds no password/TOTP
# seed, but deployment settings are not part of backups.
COMPOSE_PROJECT_NAME=pandanote
# Public host name (DNS A/AAAA to this VPS, ports 80+443 open for certificate issuance).
DOMAIN=notes.example.com
# Canonical HTTPS origin: scheme + host (+ non-default port) only; no path or trailing slash.
ORIGIN=https://notes.example.com
# Runtime user; root initializer prepares storage then permanently drops privileges.
PUID=1000
PGID=1000
# First install: generate 32 random bytes as a 43-character base64url string.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Enter at /setup within one hour; remove after setup and recreate the container.
SETUP_TOKEN=
# Builds always update latest; versioned tags remain available for pinning/rollback.
PANDANOTE_TAG=latest
# Only for low-level compose builds (not needed when loading a prebuilt image):
# PANDANOTE_VERSION=<commit-derived YYMMDD-N version, not "latest">
# PANDANOTE_COMMIT=<full Git hash>
# PANDANOTE_COMMITTED_AT=<canonical UTC commit time, e.g. 2026-10-06T00:43:59.000Z>
# Fixed private edge-network addresses. Change only if 172.28.0.0/24 conflicts.
EDGE_SUBNET=172.28.0.0/24
EDGE_PROXY_IP=172.28.0.2
APP_IP=172.28.0.10
# Optional overrides (defaults shown). Domain handlers/disk reserve stay authoritative.
# HTTP_PORT=80
# HTTPS_PORT=443
# BODY_SIZE_LIMIT=64G
# BODY_SIZE_LIMIT_CADDY=64GB
# DISK_RESERVE_BYTES=5368709120
# Local drills only (never production): CADDY_TLS_DIRECTIVE=tls internal
