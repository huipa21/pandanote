# Caddy obtains/renews a public certificate automatically for a public DOMAIN with
# ports 80/443 reachable. Local drills use Caddy's internal CA (see CADDY_TLS_DIRECTIVE).
{$DOMAIN} {
	# Empty in production (automatic public certificates). Release drills set
	# CADDY_TLS_DIRECTIVE="tls internal" to use Caddy's local CA for a synthetic name.
	{$CADDY_TLS_DIRECTIVE:}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Streaming restore archives and large files: no whole-body buffering by Caddy.
	# Keep this equal to the app BODY_SIZE_LIMIT; the app's domain limits stay authoritative.
	request_body {
		max_size {$BODY_SIZE_LIMIT_CADDY:64GB}
	}

	reverse_proxy app:3000 {
		# MUST overwrite, not append: the app trusts exactly this single address.
		header_up X-Forwarded-For {remote_host}
		flush_interval -1
		health_uri /health
		health_interval 5s
		health_timeout 3s
		# Mask a short app restart/upgrade: retry instead of an immediate 502/503.
		lb_try_duration 30s
		lb_try_interval 500ms
		transport http {
			dial_timeout 5s
			# Long uploads/restores: no response-header cutoff beyond validation time.
			response_header_timeout 15m
		}
	}
}
