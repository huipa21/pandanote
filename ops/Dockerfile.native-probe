# Test-only minimized musl/native install and genuine compilation fallback.
ARG NODE_IMAGE=docker.io/library/node:24.21.0-alpine3.23@sha256:9ec4a2e289874ed0d722e1772ec2de45d2801541db8612f3638b26f128c69ac2
FROM ${NODE_IMAGE} AS deps
RUN apk add --no-cache ca-certificates python3 make g++
WORKDIR /app
COPY ops/runtime/package.json ops/runtime/package-lock.json .npmrc ./
RUN npm ci --omit=dev --omit=peer
COPY src/lib ./src/lib
COPY tests/release/native-probe.ts ./tests/release/
COPY scripts/runtime-dependency-contract.ts scripts/container-user.ts ./scripts/
RUN node tests/release/native-probe.ts
RUN node --input-type=module -e "import {runtimeRoots,forbiddenRuntimePackages} from './scripts/runtime-dependency-contract.ts';import fs from 'node:fs';for(const p of Object.keys(runtimeRoots))await import(p);for(const p of forbiddenRuntimePackages)if(fs.existsSync('node_modules/'+p))throw Error('Forbidden '+p);const arch=process.arch==='x64'?'x64':'arm64';for(const p of ['sharp','sharp-libvips'])if(!fs.existsSync('node_modules/@img/'+p+'-linuxmusl-'+arch))throw Error('Missing musl optional package');console.log('PASS roots/inventory/musl optional packages');"
FROM deps AS fallback
# prebuild-install honors these controls; use headers supplied by the pinned base.
# npm11 warns about future config removal, but the recorded build compiles CC/CXX.
RUN npm_config_build_from_source=true npm_config_nodedir=/usr/local npm rebuild better-sqlite3 --foreground-scripts
RUN node tests/release/native-probe.ts
FROM ${NODE_IMAGE} AS minimal
RUN apk add --no-cache ca-certificates libstdc++
WORKDIR /app
COPY --from=fallback /app /app
RUN node tests/release/native-probe.ts
# Real native TS privilege drop + execve, not merely API-existence checks.
RUN node --input-type=module -e "import {becomeContainerUser} from './scripts/container-user.ts';import assert from 'node:assert/strict';import fs from 'node:fs';becomeContainerUser({uid:12345,gid:12346},{dataDir:'/tmp/pn-probe-private',production:true});assert.equal(process.getuid(),12345);assert.equal(process.getgid(),12346);assert.deepEqual(process.getgroups(),[12346]);assert.match(fs.readFileSync('/proc/self/status','utf8'),/CapEff:\\s+0000000000000000/);process.execve(process.execPath,[process.execPath,'tests/release/native-probe.ts'],process.env);"
USER 1000:1000
CMD ["node", "tests/release/native-probe.ts"]
